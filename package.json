{
  "name": "dsh-ai-for-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Per-conversation layered project memory for DeepSeek Harness, rewritten from ai-game-for-memory: isolated conversation stores, a shared layer, cross-conversation search, process log, archive, snapshots, context compaction and restore, risk-reviewed decisions. Test build.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuugakw/dsh-ai-for-memory.git"
  },
  "homepage": "https://github.com/kuugakw/dsh-ai-for-memory#readme",
  "bugs": {
    "url": "https://github.com/kuugakw/dsh-ai-for-memory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "snapshot",
    "bm25",
    "decision-review"
  ],
  "license": "MIT"
}
