{
  "name": "dsh-ai-for-memory",
  "version": "0.5.6",
  "type": "module",
  "description": "面向 DSH 的项目级记忆插件：按对话隔离的六层项目记忆、共享层、可检索知识库、可恢复上下文、风险决策审查，以及可选的 SQL/RAG/本地 llama.cpp 检索增强。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "models/README.md",
    "models/Embedding/README.md",
    "models/Rerank/README.md",
    "models/Routing/README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "test"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "scripts": {
    "test": "node --test test/core.test.mjs test/session-doctor.test.mjs test/conversation-access.test.mjs",
    "prepublishOnly": "npm test",
    "market:build": "node scripts/market/build-index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "kuugakw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuugakw/dsh-ai-for-memory.git"
  },
  "homepage": "https://github.com/kuugakw/dsh-ai-for-memory#readme",
  "bugs": {
    "url": "https://github.com/kuugakw/dsh-ai-for-memory/issues"
  },
  "keywords": [
    "ai-memory",
    "agent-memory",
    "llm-memory",
    "mcp-server",
    "memory",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "snapshot",
    "bm25",
    "decision-review",
    "rag",
    "embeddings",
    "rerank",
    "sqlite",
    "text-to-sql",
    "context",
    "compaction",
    "repair"
  ],
  "license": "MIT"
}
